Thumbs.db
ehthumbs.db
Desktop.ini

# macOS
.DS_Store
.AppleDouble
.LSOverride

# 备份文件
*.bak
*.old
*.tmp
*~

# VS Code / IDE
.vscode/
.idea/
.claude
*.swp
*.swo

# 设计文档排除上传
